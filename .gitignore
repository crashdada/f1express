# Dependencies
node_modules/

# Build output (committed intentionally for NAS direct hosting)
# dist/ is tracked on purpose. Rebuild and commit it when source changes affect the web bundle.

# Local dev artifacts
dist-ssr/
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local temp/debug artifacts
.tmp_*
tmp_*
*.bak

# Database backups (local only, not for repo)
backups/
storage/backups/

# Data storage separation (Tracked for stateless image bundling)
!storage/f1.db
!storage/photos/
storage/live/
storage/uploads/
# (storage/csv and storage/assets ARE tracked)

# Temporary upload staging area
docker/uploads/

# Android / Capacitor - commit source, ignore build artifacts
android/app/build/
android/.gradle/
android/local.properties
# Web assets in android are regenerated by 'cap sync' - don't commit the large copy
android/app/src/main/assets/public/
ios/
.capacitor/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# OS
Thumbs.db
