{
  "name": "f1express",
  "version": "1.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sync": "python scripts/sync_f1_data.py && vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest --run",
    "test:unit": "vitest --run tests/unit",
    "test:integration": "vitest --run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "pipeline:sync": "python scripts/sync_f1_data.py",
    "pipeline:sync:full": "python scripts/sync_f1_data.py --force",
    "pipeline:sync:validate": "python scripts/sync_f1_data.py --validate-constructors",
    "android:sync": "npx cap sync android && node scripts/sync_android_assets.cjs",
    "validate:constructors": "python scripts/pipeline/validate_constructor_totals.py",
    "verify:dist": "node scripts/verify_dist_freshness.cjs",
    "validate:docker": "node scripts/validate_docker_bundle.cjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/status-bar": "^8.0.1",
    "better-sqlite3": "^12.6.2",
    "chart.js": "^4.5.1",
    "cross-spawn": "^7.0.6",
    "csv-parse": "^6.1.0",
    "csv-parser": "^3.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.563.0",
    "openai": "^6.25.0",
    "react": "^19.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.2.7",
    "recharts": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.3",
    "@vitest/ui": "^3.2.3",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "sharp": "^0.34.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^3.2.3"
  }
}
