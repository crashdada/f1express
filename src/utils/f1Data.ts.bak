import { Driver, RaceResult, Team, SeasonStats, ProcessedDriverData, RaceInfo } from '../types';
import { CIRCUIT_TRANSLATIONS, COUNTRY_TRANSLATIONS, TEAM_TRANSLATIONS } from './translations';

const DB_NAME = 'F1DatabaseStore_v38'; // Force refresh (v38 - fix broken 2026 schedule assets)
const STORE_NAME = 'files';
const DB_VERSION = 1; // Reset version for new store
const DB_FILE_KEY = 'f1.db';

const openDb = (): Promise<IDBDatabase> => {
  return new Promise((resolve, reject) => {
    const request = indexedDB.open(DB_NAME, DB_VERSION);
    request.onupgradeneeded = (event: any) => {
      const db = event.target.result;
      if (!db.objectStoreNames.contains(STORE_NAME)) {
        db.createObjectStore(STORE_NAME);
      }
    };
    request.onsuccess = () => {
      const db = request.result;
      // Fail-safe: if store is missing despite successful open, we have a corrupted state
      if (!db.objectStoreNames.contains(STORE_NAME)) {
        db.close();
        indexedDB.deleteDatabase(DB_NAME);
        reject(new Error('Object store not found, deleting database for reset'));
      } else {
        resolve(db);
      }
    };
    request.onerror = () => reject(request.error);
  });
};

const getCachedDb = async (): Promise<Uint8Array | null> => {
  try {
    const db = await openDb();
    return new Promise((resolve) => {
      const transaction = db.transaction(STORE_NAME, 'readonly');
      const store = transaction.objectStore(STORE_NAME);
      const request = store.get(DB_FILE_KEY);
      request.onsuccess = () => resolve(request.result || null);
      request.onerror = () => resolve(null);
    });
  } catch (e) {
    return null;
  }
};

const saveDbToCache = async (data: Uint8Array) => {
  try {
    const db = await openDb();
    return new Promise<void>((resolve) => {
      const transaction = db.transaction(STORE_NAME, 'readwrite');
      const store = transaction.objectStore(STORE_NAME);
      store.put(data, DB_FILE_KEY);
      transaction.oncomplete = () => resolve();
      transaction.onerror = () => resolve();
    });
  } catch (e) {
    console.warn('Failed to save DB to cache:', e);
  }
};

let dbInitialized = false;

export const loadF1Data = async (): Promise<ProcessedDriverData> => {
  try {
    if (!dbInitialized) {
      const initSqlJs = (window as any).initSqlJs;
      if (!initSqlJs) {
        throw new Error('sql.js not loaded');
      }

      const SQL = await initSqlJs({
        locateFile: (file: string) => `/libs/sql.js/${file}`
      }) as any;

      // Use IndexedDB cache to speed up loading
      let buffer: Uint8Array | null = await getCachedDb();

      if (buffer) {
        console.log('Using cached database from IndexedDB, size:', (buffer as Uint8Array).byteLength);
      } else {
        console.log('Fetching database from /data/f1.db...');
        // Add timestamp to bypass browser cache
        const response = await fetch(`/data/f1.db?t=${Date.now()}`);
        if (!response.ok) throw new Error(`Failed to fetch database: ${response.status}`);

        const arrayBuffer = await response.arrayBuffer();
        buffer = new Uint8Array(arrayBuffer);
        console.log('Database downloaded, size:', buffer.byteLength);

        // Save to cache for next time
        await saveDbToCache(buffer);
        console.log('Database saved to IndexedDB cache');
      }

      if (buffer && buffer.byteLength === 0) throw new Error('Database file is empty');

      const db = new SQL.Database(buffer);
      (window as any).f1Db = db;
      dbInitialized = true;
      console.log('Database initialized successfully');
    }

    const db = (window as any).f1Db;

    // Helper to handle malformed DB error by clearing cache
    const safeExec = (sql: string) => {
      try {
        return db.exec(sql);
      } catch (e: any) {
        if (e.message?.includes('malformed') || e.toString().includes('malformed')) {
          console.error('Database malformed detected! Clearing IndexedDB cache...');
          indexedDB.deleteDatabase(DB_NAME);
          // Reload page to start fresh
          window.location.reload();
        }
        throw e;
      }
    };

    // Use driver_season_stats for accurate totals (including Sprints and corrections)
    // Perf: replace per-row correlated subqueries with pre-aggregated JOINs
    const driversQuery = safeExec(`
SELECT
d.driver_id,
  d.code,
  d.first_name,
  d.last_name,
  d.first_name_cn,
  d.last_name_cn,
  d.nationality,
  d.birth_date,
  d.birth_place,
  d.age,
  d.number,
  COALESCE(SUM(CAST(dss.points AS FLOAT)), 0) as total_points,
  COALESCE(SUM(dss.wins), 0) as total_wins,
  COALESCE(SUM(dss.podiums), 0) as total_podiums,
  COALESCE(SUM(dss.poles), 0) as total_poles,
  COALESCE(champ.championships, 0) as championships,
  COALESCE(champ.years, '') as championship_years,
  COALESCE(dp.url, '') as avatar,
  COALESCE(last_team.color, '#6b7280') as team_color
      FROM drivers d
      LEFT JOIN driver_season_stats dss ON d.driver_id = dss.driver_id
      LEFT JOIN driver_photos dp ON d.driver_id = dp.driver_id
      LEFT JOIN(
    SELECT driver_id, COUNT(*) as championships, GROUP_CONCAT(season) as years
        FROM driver_championships WHERE rank = 1
        GROUP BY driver_id
  ) champ ON d.driver_id = champ.driver_id
      LEFT JOIN(
    SELECT dss2.driver_id, t.color
        FROM driver_season_stats dss2
        JOIN teams t ON dss2.team_id = t.team_id
        WHERE(dss2.driver_id, dss2.season) IN(
      SELECT driver_id, MAX(season) FROM driver_season_stats GROUP BY driver_id
    )
  ) last_team ON d.driver_id = last_team.driver_id
      GROUP BY d.driver_id
      ORDER BY total_points DESC
  `);

    // Use team_season_stats for accurate team totals
    const teamsQuery = safeExec(`
SELECT
t.team_id,
  t.name,
  t.full_name,
  t.color,
  COALESCE(tp.url, '') as logo,
  COALESCE(SUM(tss.points), 0) as total_points,
  COALESCE(SUM(tss.wins), 0) as total_wins,
  COALESCE(SUM(tss.podiums), 0) as total_podiums,
  COALESCE(SUM(tss.poles), 0) as total_poles,
  COALESCE((
    SELECT COUNT(*) 
          FROM team_championships tc 
          WHERE tc.team_id = t.team_id AND tc.rank = 1
  ), 0) as championships,
    COALESCE((
      SELECT COUNT(DISTINCT dc.season) 
          FROM driver_championships dc 
          WHERE dc.team_id = t.team_id AND dc.rank = 1
    ), 0) as driver_championships
      FROM teams t
      LEFT JOIN team_season_stats tss ON t.team_id = tss.team_id
      LEFT JOIN team_photos tp ON t.team_id = tp.team_id
      GROUP BY t.team_id
      ORDER BY total_points DESC
  `);

    // 查询比赛结果
    const raceResultsQuery = safeExec(`
SELECT
  rr.result_id,
  rr.driver_id,
  rr.position,
  rr.laps,
  rr.time,
  rr.points,
  rr.status,
  d.first_name,
  d.last_name,
  d.first_name_cn,
  d.last_name_cn,
  d.code,
  t.name as team,
  r.season,
  r.round_number,
  r.url,
  c.country as grand_prix,
  COALESCE(q.position, 0) as grid
      FROM race_results rr
      JOIN drivers d ON rr.driver_id = d.driver_id
      LEFT JOIN teams t ON rr.team_id = t.team_id
      JOIN races r ON rr.race_id = r.race_id
      JOIN circuits c ON r.circuit_id = c.circuit_id
      LEFT JOIN qualifying q ON rr.race_id = q.race_id AND rr.driver_id = q.driver_id
      ORDER BY r.season DESC, r.round_number, rr.position
  `);

    // NEW: Query individual season rankings for drivers
    const driverChampsQuery = safeExec(`
      SELECT driver_id, season, rank 
      FROM driver_championships
    `);

    // 查询比赛信息（用于比赛页面）
    const raceInfoQuery = safeExec(`
      SELECT DISTINCT
r.season,
  r.round_number as roundNo,
  c.name as circuit,
  r.race_date as startDate,
  r.race_date as endDate,
  r.url,
  (
    SELECT d.first_name
          FROM race_results rr2
          JOIN drivers d ON rr2.driver_id = d.driver_id
          WHERE rr2.race_id = r.race_id AND rr2.position = 1
          LIMIT 1
        ) as poleFirstName,
  (
    SELECT d.first_name_cn
          FROM race_results rr2
          JOIN drivers d ON rr2.driver_id = d.driver_id
          WHERE rr2.race_id = r.race_id AND rr2.position = 1
          LIMIT 1
        ) as poleFirstNameCn,
  (
    SELECT d.last_name
          FROM race_results rr2
          JOIN drivers d ON rr2.driver_id = d.driver_id
          WHERE rr2.race_id = r.race_id AND rr2.position = 1
          LIMIT 1
        ) as poleLastName,
  (
    SELECT d.last_name_cn
          FROM race_results rr2
          JOIN drivers d ON rr2.driver_id = d.driver_id
          WHERE rr2.race_id = r.race_id AND rr2.position = 1
          LIMIT 1
        ) as poleLastNameCn,
  (
    SELECT d.code
          FROM race_results rr2
          JOIN drivers d ON rr2.driver_id = d.driver_id
          WHERE rr2.race_id = r.race_id AND rr2.position = 1
          LIMIT 1
        ) as poleCode,
  r.race_date as poleTime,
  c.country
      FROM races r
      JOIN circuits c ON r.circuit_id = c.circuit_id
      ORDER BY r.season DESC, r.round_number
  `);

    // 查询赛季统计（从比赛结果聚合）
    const seasonStatsQuery = safeExec(`
SELECT
r.season,
  d.first_name || ' ' || d.last_name as winner,
  t.name as team,
  COUNT(DISTINCT r.race_id) as races
      FROM races r
      JOIN race_results rr ON r.race_id = rr.race_id
      JOIN drivers d ON rr.driver_id = d.driver_id
      LEFT JOIN teams t ON rr.team_id = t.team_id
      WHERE rr.position = 1
      GROUP BY r.season
      ORDER BY r.season DESC
    `);

    // 加载照片索引
    let photosIndex: string[] = [];
    try {
      const pResponse = await fetch('/photos/index.json');
      if (pResponse.ok) {
        photosIndex = await pResponse.json();
      }
    } catch (e) {
      console.warn('Failed to load photos index');
    }

    // 🆕 加载 2026 数据
    let schedule: any[] = [];
    let results2026: any[] = [];
    let drivers2026: any[] = [];
    try {
      const [sRem, rRem, dRem] = await Promise.all([
        fetch(`/data/schedule_2026.json?t=${Date.now()}`),
        fetch(`/data/results_2026.json?t=${Date.now()}`).catch(() => null),
        fetch(`/data/drivers_2026.json?t=${Date.now()}`).catch(() => null)
      ]);

      if (sRem.ok) schedule = await sRem.json();
      if (rRem && rRem.ok) results2026 = await rRem.json();
      if (dRem && dRem.ok) drivers2026 = await dRem.json();
    } catch (e) {
      console.warn('Failed to load 2026 additional data', e);
    }

    // 转换数据 helper
    const convertQueryToData = (queryResult: any) => {
      if (!queryResult || queryResult.length === 0) return [];
      const columns = queryResult[0].columns;
      return queryResult[0].values.map((row: any) => {
        const obj: any = {};
        columns.forEach((col: string, i: number) => { obj[col] = row[i]; });
        return obj;
      });
    };

    const driversData = convertQueryToData(driversQuery);
    const teamsData = convertQueryToData(teamsQuery);
    const raceResultsData = convertQueryToData(raceResultsQuery);
    const raceInfoData = convertQueryToData(raceInfoQuery);
    const seasonStatsData = convertQueryToData(seasonStatsQuery);
    const driverChampsData = convertQueryToData(driverChampsQuery);

    // 计算 2026 实时统计以供 enrichment
    const live2026Stats: Record<string, { points: number, wins: number, podiums: number, poles: number }> = {};
    results2026.forEach(round => {
      round.results?.forEach((r: any) => {
        if (!live2026Stats[r.code]) live2026Stats[r.code] = { points: 0, wins: 0, podiums: 0, poles: 0 };
        live2026Stats[r.code].points += Number(r.points || 0);
        if (r.pos === 1) live2026Stats[r.code].wins += 1;
        if (r.pos && r.pos <= 3) live2026Stats[r.code].podiums += 1;
      });
      round.sprintResults?.forEach((r: any) => {
        if (!live2026Stats[r.code]) live2026Stats[r.code] = { points: 0, wins: 0, podiums: 0, poles: 0 };
        live2026Stats[r.code].points += Number(r.points || 0);
        // Sprint wins/podiums not counted in official career stats according to user preference
      });
      if (round.polePosition?.code) {
        const pCode = round.polePosition.code;
        if (!live2026Stats[pCode]) live2026Stats[pCode] = { points: 0, wins: 0, podiums: 0, poles: 0 };
        live2026Stats[pCode].poles += 1;
      }
    });

    // 处理数据
    const drivers = processDrivers(driversData, photosIndex, drivers2026, live2026Stats);
    const teams = processTeams(teamsData);
    let raceResults = processRaceResults(raceResultsData);

    // Merge 2026 results into global raceResults
    if (results2026.length > 0) {
      // Create a map from code to driverId for bridging 2026 JSON data with DB data
      const codeToIdMap = new Map<string, number>();
      drivers.forEach(d => { if (d.code) codeToIdMap.set(d.code, d.id as number); });

      const processed2026 = results2026.flatMap((round: any) => {
        const roundResults = (round.results || []).map((r: any) => ({
          resultId: 2026000 + round.round * 100 + (r.pos || 99),
          driverId: codeToIdMap.get(r.code) || 0,
          position: r.pos || 0,
          number: r.number || 0,
          firstName: r.firstName || '',
          lastName: r.lastName || '',
          firstNameCn: r.firstNameCn || '',
          lastNameCn: r.lastNameCn || '',
          code: r.code || '',
          team: r.team || '',
          laps: 0,
          time: '',
          points: Number(r.points || 0),
          grid: 0,
          fastestLapTime: '',
          url: '',
          season: 2026,
          grandPrix: round.country || `Round ${round.round}`,
          circuit: '',
          date: round.date || '',
          roundNo: round.round,
          isSprint: false,
        }));

        const sprintResults = (round.sprintResults || []).map((r: any) => ({
          resultId: 2026500 + round.round * 100 + (r.pos || 99),
          driverId: codeToIdMap.get(r.code) || 0,
          position: r.pos || 0,
          number: r.number || 0,
          firstName: r.firstName || '',
          lastName: r.lastName || '',
          firstNameCn: r.firstNameCn || '',
          lastNameCn: r.lastNameCn || '',
          code: r.code || '',
          team: r.team || '',
          laps: 0,
          time: '',
          points: Number(r.points || 0),
          grid: 0,
          fastestLapTime: '',
          url: '',
          season: 2026,
          grandPrix: `${round.country} (Sprint)`,
          circuit: '',
          date: round.date || '',
          roundNo: round.round,
          isSprint: true,
        }));

        return [...roundResults, ...sprintResults];
      });
      raceResults = [...processed2026, ...raceResults];
    }

    const raceInfo = processRaceInfo(raceInfoData);
    const seasonStats = processSeasonStats(seasonStatsData);
    const driverChampionships = driverChampsData.map((d: any) => ({
      driverId: d.driver_id,
      season: d.season,
      rank: d.rank
    }));

    console.log('Loaded:', drivers.length, 'drivers,', teams.length, 'teams,', raceResults.length, 'race results');
    return { drivers, raceResults, teams, seasonStats, schedule, raceInfo, photosIndex, driverChampionships };
  } catch (error) {
    console.error('Error loading F1 data:', error);
    return { drivers: [], raceResults: [], teams: [], seasonStats: [], schedule: [], raceInfo: [], photosIndex: [], driverChampionships: [] };
  }
};

function processDrivers(
  driversData: any[],
  photosIndex: string[],
  drivers2026: any[] = [],
  live2026Stats: Record<string, any> = {}
): Driver[] {
  // Create a map for 2026 driver configs for easy lookup
  const d2026Map = new Map<string, any>();
  drivers2026.forEach(d => { if (d.code) d2026Map.set(d.code, d); });

  const photoMap = new Map<string, string>(); // key: lowercase filename -> value: full relative path
  for (const p of photosIndex) {
    const filename = p.split('/').pop()?.toLowerCase() || '';
    if (filename && !photoMap.has(filename)) {
      photoMap.set(filename, p);
    }
  }

  return driversData.map(driver => {
    const code = driver['code'] || '';
    const d2026 = d2026Map.get(code);
    const l2026 = live2026Stats[code];

    let points = Number(driver['total_points'] || 0);
    let wins = Number(driver['total_wins'] || 0);
    let podiums = Number(driver['total_podiums'] || 0);
    let poles = Number(driver['total_poles'] || 0);

    // Enrich with 2026 data if available
    if (d2026 && d2026.careerStats) {
      // Use the authoritative career stats from the 2026 snapshot (which includes end of 2025 data correctly)
      points = Number(d2026.careerStats.points);
      wins = Number(d2026.careerStats.wins);
      podiums = Number(d2026.careerStats.podiums);
      poles = Number(d2026.careerStats.poles);
    }

    // Add live 2026 performance
    if (l2026) {
      if (code === 'RUS') console.log('RUS Live Stats Found:', l2026);
      points += l2026.points;
      wins += l2026.wins;
      podiums += l2026.podiums;
      poles += l2026.poles;
    } else {
      if (code === 'RUS') console.log('RUS Live Stats NOT Found!');
    }

    const baseDriver: Driver = {
      id: driver['driver_id'],
      number: driver['number'] || 0,
      firstName: driver['first_name'] || '',
      lastName: driver['last_name'] || '',
      firstNameCn: driver['first_name_cn'] || '',
      lastNameCn: driver['last_name_cn'] || '',
      code: code,
      team: '',
      nationality: driver['nationality'] || '',
      birthDate: driver['birth_date'] || undefined,
      birthPlace: driver['birth_place'] || undefined,
      age: driver['age'] || undefined,
      points: points,
      wins: wins,
      podiums: podiums,
      poles: poles,
      championships: driver['championships'] || 0,
      championshipYears: driver['championship_years'] ? driver['championship_years'].toString().split(',').map(Number) : [],
      avatar: driver['avatar'] || '',
      teamColor: driver['team_color'] || '',
    };

    if (!baseDriver.avatar && photoMap.size > 0) {
      baseDriver.avatar = getLocalDriverPhotoPath(baseDriver, photoMap) || '';
    }

    return baseDriver;
  });
};
function processTeams(teamsData: any[]): Team[] {
  return teamsData.map(team => {
    const name = team['name'] || '';
    return {
      id: name, // Using name as ID for identity checks
      name: name,
      fullName: team['full_name'] || name || '',
      nameCn: TEAM_TRANSLATIONS[name] || name,
      points: team['total_points'] || 0,
      wins: team['total_wins'] || 0,
      podiums: team['total_podiums'] || 0,
      poles: team['total_poles'] || 0,
      championships: team['championships'] || 0,
      driverChampionships: team['driver_championships'] || 0,
      championshipYears: [],
      color: team['color'] || '#e10600',
      logo: team['logo'] || '',
    };
  });
};

function processRaceResults(raceResultsData: any[]): RaceResult[] {
  return raceResultsData.map(result => ({
    resultId: result['result_id'],
    driverId: result['driver_id'] || 0,
    position: result['position'] || 0,
    number: 0,
    firstName: result['first_name'] || '',
    lastName: result['last_name'] || '',
    firstNameCn: result['first_name_cn'] || '',
    lastNameCn: result['last_name_cn'] || '',
    code: result['code'] || '',
    team: result['team'] || '',
    laps: result['laps'] || 0,
    time: result['time'] || '',
    points: result['points'] || 0,
    grid: result['grid'] || 0,
    fastestLapTime: result['fastest_lap_time'] || '',
    url: result['url'] || '',
    season: result['season'],
    grandPrix: result['grand_prix'] || 'Round ' + (result['round_number'] || 0),
    circuit: '',
    date: '',
    roundNo: result['round_number'] || 0,
    isSprint: false,
  }));
};

function processRaceInfo(raceInfoData: any[]): RaceInfo[] {
  return raceInfoData.map(race => {
    const circuitName = race['circuit'] || '';
    const countryName = race['country'] || '';
    return {
      season: race['season'] || 0,
      roundNo: race['roundNo'] || 0,
      circuit: circuitName,
      circuitCn: CIRCUIT_TRANSLATIONS[circuitName] || circuitName,
      poleTime: race['poleTime'] || '',
      poleFirstName: race['poleFirstName'] || '',
      poleFirstNameCn: race['poleFirstNameCn'] || '',
      poleLastName: race['poleLastName'] || '',
      poleLastNameCn: race['poleLastNameCn'] || '',
      poleCode: race['poleCode'] || '',
      country: countryName,
      countryCn: COUNTRY_TRANSLATIONS[countryName] || countryName,
      startDate: race['startDate'] || '',
      endDate: race['endDate'] || '',
      url: race['url'] || '',
    };
  });
};

export const processSeasonStats = (seasonStatsData: any[]): SeasonStats[] => {
  return seasonStatsData.map(stat => ({
    season: stat['season'],
    winner: stat['winner'] || 'Unknown',
    team: stat['team'] || 'Unknown',
    races: stat['races'] || 0,
  }));
};

export const getCurrentSeason = (): number => {
  return new Date().getFullYear();
};

export const getDriverDisplayName = (driver: { firstName: string; lastName: string; firstNameCn?: string; lastNameCn?: string }): string => {
  if (driver.firstNameCn && driver.lastNameCn) {
    return `${driver.lastNameCn}${driver.firstNameCn}`; // Chinese format usually SurnameFirst
  }
  return `${driver.firstName} ${driver.lastName}`;
};

/**
 * 移除变体字符（如 Räikkönen -> Raikkonen）
 */
const normalizeName = (name: string): string => {
  return name.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
};

/**
 * 匹配本地车手照片路径 (内部使用，processDrivers 阶段调用)
 * @param photoMap - key: 小写文件名, value: 相对路径 (由 processDrivers 预构建)
 */
const getLocalDriverPhotoPath = (
  driver: { firstName: string, lastName: string },
  photoMap: Map<string, string>
): string | null => {
  if (!photoMap || photoMap.size === 0) return null;

  const rawLast = driver.lastName.replace(/\s+/g, '_');
  const rawFirst = driver.firstName.replace(/\s+/g, '_');
  const normLast = normalizeName(rawLast);
  const normFirst = normalizeName(rawFirst);

  // 候选文件名（按最常用到最少用排序）
  const candidates = [
    `${normLast.toUpperCase()}_${normFirst}.webp`,
    `${normLast.toUpperCase()}_${normFirst.toUpperCase()}.webp`,
    `${rawLast.toUpperCase()}_${rawFirst}.webp`,
  ];

  for (const candidate of candidates) {
    const key = candidate.toLowerCase();
    if (photoMap.has(key)) {
      return `/ photos / ${photoMap.get(key)} `;
    }
  }

  return null;
};

export const getTeamDisplayName = (team: { name: string; fullName?: string; nameCn?: string }): string => {
  if (team.nameCn) return team.nameCn;
  if (team.fullName) return team.fullName;
  return team.name;
};
